# ==============================================================================
# NM MOCK INTERVIEW SANDBOX — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# NOTE: This file contains variable names only. Do NOT add secrets or values here.
# Copy this file to .env on your deployment host and supply valid production values.

# ------------------------------------------------------------------------------
# 1. Global & Common Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=
PORT=
LOG_LEVEL=
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL - Sole Authoritative Database)
# ------------------------------------------------------------------------------
DATABASE_URL=
AUTH_DATABASE_URL=
USER_DATABASE_URL=
INTERVIEW_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Authentication & Security (Auth Service & Middleware)
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=

# ------------------------------------------------------------------------------
# 4. Email / SMTP Configuration (Auth Service - Password Reset & Verification)
# ------------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECURE=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# 5. API Gateway & Microservice Routing Ports / Hosts
# ------------------------------------------------------------------------------
GATEWAY_HOST=
GATEWAY_PORT=
AUTH_SERVICE_HOST=
AUTH_SERVICE_PORT=
USER_SERVICE_HOST=
USER_SERVICE_PORT=
INTERVIEW_SERVICE_HOST=
INTERVIEW_SERVICE_PORT=
QUESTION_BANK_SERVICE_HOST=
QUESTION_BANK_SERVICE_PORT=
JUDGE_SERVICE_HOST=
JUDGE_SERVICE_PORT=

# ------------------------------------------------------------------------------
# 6. User Service & Storage Configuration
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=
LOCAL_STORAGE_URL=

# ------------------------------------------------------------------------------
# 7. AI & LLM Evaluation Engine (Interview Service)
# ------------------------------------------------------------------------------
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
QUESTION_BANK_SERVICE_URL=

# ------------------------------------------------------------------------------
# 8. Judge0 Code Execution Engine (Judge Service)
# ------------------------------------------------------------------------------
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
MAX_GLOBAL_CONCURRENT_EXECUTIONS=
MAX_CONCURRENT_EXECUTIONS_PER_USER=

# ------------------------------------------------------------------------------
# 9. Frontend Configuration (Vite Client Application)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
